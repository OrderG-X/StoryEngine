{
  "note": "服务端分层（下层不许引上层，P7 第 6 步定）：核心 < 老格式书 book < 基础设施 lib < 写稿 writing < 编辑部 editorial < 流程 services < 对话 AI agent < HTTP 出口 routes。",
  "rules": [
    {
      "dir": "packages/story-core/src",
      "forbid": [
        "packages/story-engine-ui/",
        "@mastra/",
        "ai",
        "@ai-sdk/"
      ],
      "why": "核心包只放真相、命令、投影和纯文本小件，纯 TypeScript、不碰模型、不引用界面包和服务端"
    },
    {
      "dir": "packages/story-engine-ui/src/server/book",
      "forbid": [
        "packages/story-engine-ui/src/server/lib/",
        "packages/story-engine-ui/src/server/writing/",
        "packages/story-engine-ui/src/server/editorial/",
        "packages/story-engine-ui/src/server/services/",
        "packages/story-engine-ui/src/server/agent/",
        "packages/story-engine-ui/src/server/routes/",
        "@mastra/",
        "ai",
        "@ai-sdk/"
      ],
      "why": "服务端第 1 层 老格式书（读写书目录的老文件、总览、核心到老文件的镜像）：只用核心，不引服务端其它层和模型 SDK",
      "allow": [
        "packages/story-engine-ui/src/server/lib/home-test-tmp"
      ]
    },
    {
      "dir": "packages/story-engine-ui/src/server/lib",
      "forbid": [
        "packages/story-engine-ui/src/server/writing/",
        "packages/story-engine-ui/src/server/editorial/",
        "packages/story-engine-ui/src/server/services/",
        "packages/story-engine-ui/src/server/agent/",
        "packages/story-engine-ui/src/server/routes/"
      ],
      "why": "服务端第 2 层 基础设施（读写盘、存档、模型调用主干、设置）：只用核心和老格式书，不引写稿、编辑部、流程、对话 AI、HTTP 出口"
    },
    {
      "dir": "packages/story-engine-ui/src/server/writing",
      "forbid": [
        "packages/story-engine-ui/src/server/editorial/",
        "packages/story-engine-ui/src/server/services/",
        "packages/story-engine-ui/src/server/agent/",
        "packages/story-engine-ui/src/server/routes/",
        "@mastra/"
      ],
      "why": "服务端第 3 层 写稿底层（出稿写手、上下文、长度、审稿改稿提示词、在场检测、AI 味规则）：不引编辑部、流程、对话 AI、HTTP 出口"
    },
    {
      "dir": "packages/story-engine-ui/src/server/editorial",
      "forbid": [
        "packages/story-engine-ui/src/server/services/",
        "packages/story-engine-ui/src/server/agent/",
        "packages/story-engine-ui/src/server/routes/",
        "@mastra/",
        "ai",
        "@ai-sdk/"
      ],
      "why": "服务端第 4 层 编辑部（核账、记账、章纲、头脑风暴、跟读）：模型经基础设施调用，不引流程、对话 AI、HTTP 出口和模型 SDK"
    },
    {
      "dir": "packages/story-engine-ui/src/server/services",
      "forbid": [
        "packages/story-engine-ui/src/server/agent/",
        "packages/story-engine-ui/src/server/routes/"
      ],
      "why": "服务端第 5 层 流程（出稿流水线、改稿、审稿、质检、做厚、开书概况），对话 AI 和 HTTP 共用：不引对话 AI 和 HTTP 出口"
    },
    {
      "dir": "packages/story-engine-ui/src/server/agent",
      "forbid": [
        "packages/story-engine-ui/src/server/routes/"
      ],
      "why": "服务端第 6 层 对话 AI（工具、指令、模型接线）：不引 HTTP 出口"
    }
  ]
}
