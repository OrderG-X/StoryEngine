{
  "name": "@actalk/story-engine-cli",
  "version": "0.0.0",
  "description": "Fast Draft CLI for StoryEngine-NG",
  "type": "module",
  "bin": {
    "story-engine": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/tests"
  ],
  "license": "AGPL-3.0-only",
  "scripts": {
    "prepare:workspace-story-engine": "corepack pnpm --filter @actalk/story-engine build",
    "prebuild": "corepack pnpm run prepare:workspace-story-engine",
    "build": "tsc",
    "dev": "tsc --watch",
    "pretest": "corepack pnpm run build",
    "test": "node ../../test-tools/run-vitest.mjs run",
    "pretypecheck": "corepack pnpm run prepare:workspace-story-engine",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@actalk/story-engine": "workspace:*",
    "commander": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
