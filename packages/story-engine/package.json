    "dev": "tsc --watch",
    "prepare": "tsc",
    "test": "node ../../test-tools/run-vitest.mjs run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
