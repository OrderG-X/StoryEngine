{
  "name": "@actalk/story-engine",
  "version": "0.0.0",
  "description": "StoryEngine-NG minimal state-first interactive narrative kernel",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/tests"
  ],
