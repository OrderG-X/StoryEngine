{
  "name": "@actalk/story-engine-ui",
  "version": "0.0.0",
  "private": true,
  "description": "StoryEngine-NG local Chinese author workbench and standalone server",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "prebuild": "corepack pnpm --filter @actalk/story-engine build",
    "build": "node scripts/check-import-boundary.mjs && tsc --noEmit && vite build",
    "check:imports": "node scripts/check-import-boundary.mjs",
    "build:server": "esbuild src/server/standalone-entry.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/server.mjs",
    "build:desktop": "pnpm run build && pnpm run build:server",
    "serve": "node dist-server/server.mjs",
    "smoke:longform": "node scripts/longform-regression-smoke.mjs",
    "pretypecheck": "corepack pnpm --filter @actalk/story-engine build",
    "test": "node ../../test-tools/run-vitest.mjs run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@actalk/story-engine": "workspace:*",
    "@ai-sdk/openai-compatible": "^2.0.50",
    "@mastra/core": "^1.42.0",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tiptap/pm": "^3.26.1",
    "@tiptap/react": "^3.26.1",
    "@tiptap/starter-kit": "^3.26.1",
    "ai": "^6.0.204",
    "connect": "^3.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sirv": "^3.0.2",
    "sonner": "^2.0.7",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/connect": "^3.4.38",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.16.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.8.0",
    "vite": "^6.0.11",
    "vitest": "^3.0.0"
  },
  "files": [
    "dist",
    "dist-server"
  ],
  "exports": {
    "./server": "./dist-server/server.mjs",
    "./package.json": "./package.json"
  }
}
